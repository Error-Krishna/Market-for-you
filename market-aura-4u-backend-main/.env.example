PORT=8000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_WINDOW_MS=900000
AUTH_MAX_IP_ATTEMPTS=30
AUTH_MAX_ACCOUNT_ATTEMPTS=10
AUTH_MAX_CONCURRENT=4
AUTH_MAX_TRACKED_KEYS=10000
# Explicit direct mode also supports Cloud Run: peer-IP budgets may be shared.
# Forwarded headers are ignored. Use trusted-cidrs only with a verified ingress path.
AUTH_PROXY_MODE=direct
AUTH_TRUSTED_PROXY_CIDRS=

MONGO_URI=

JWT_SECREAT_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=1536

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
META_UNIFIED_CONFIG_ID=1128283246795449
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000
TOKEN_ENCRYPTION_KEY=

TWITTER_ACCESS_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CHECKOUT_ENABLED=true

RECOMMENDER_URL=http://localhost:8001/recommend
RECOMMENDER_HEALTH_URL=http://localhost:8001/health
RECOMMENDER_TIMEOUT_MS=15000
# Local deadline above; for scale-to-zero Cloud Run set RECOMMENDER_TIMEOUT_MS=120000.
# An explicit 15000/60000 overrides the Cloud Run default; do not copy it unchanged.
# none is restricted to loopback development. Use cloud-run on Cloud Run.
RECOMMENDER_AUTH_MODE=none
# Cloud Run: canonical Python service origin, without /recommend or trailing slash.
# If unset in cloud-run mode, derived from RECOMMENDER_URL.
RECOMMENDER_AUDIENCE=

# Cloudflare R2 Media Storage Configuration
MEDIA_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional R2 custom endpoint override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Canonical public HTTPS domain for serving media (e.g. https://media.marketaura4u.com or https://pub-xxx.r2.dev)
R2_PUBLIC_BASE_URL=
R2_REGION=auto
MEDIA_STORAGE_PREFIX=media

# Media Storage Usage & Billing Safeguards (Application-level limits)
MEDIA_UPLOADS_ENABLED=true
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_USER_STORAGE_QUOTA_BYTES=104857600
MEDIA_USER_MONTHLY_UPLOAD_LIMIT=100

# Serverless Cron / Scheduler Security Token
CRON_SECRET=
