# ==============================================================================
# Market Aura 4U — Backend API Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
# Comma-separated list of allowed origins. In production, HTTPS origins are strictly required.
# Example: https://<market-aura-project>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL for OAuth redirects (e.g. https://<market-aura-project>.vercel.app)
FRONTEND_URL=http://localhost:5173

# Canonical public backend URL for generating OAuth callback URIs
# Example: https://<market-aura-api>.onrender.com
PUBLIC_BACKEND_URL=http://localhost:8000

# Rate Limiting & Auth Proxy Security (Direct or Trusted CIDRs)
AUTH_PROXY_MODE=direct
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_WINDOW_MS=900000
AUTH_MAX_IP_ATTEMPTS=30
AUTH_MAX_ACCOUNT_ATTEMPTS=10
AUTH_MAX_CONCURRENT=4
AUTH_MAX_TRACKED_KEYS=10000

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/market_aura
# Optional MongoDB connection pool limit (defaults: 20 for persistent servers, 10 for serverless)
MONGO_MAX_POOL_SIZE=20

# ------------------------------------------------------------------------------
# 3. SECURITY KEYS & SECRETS
# ------------------------------------------------------------------------------
# JWT Signing Key (Canonical: JWT_SECREAT_KEY; JWT_SECRET_KEY is accepted as alias)
JWT_SECREAT_KEY=replace_with_a_secure_random_64_character_hex_string
JWT_SECRET_KEY=

# AES-256-GCM Token Encryption Key (64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_a_secure_random_64_character_hex_string

# Serverless Scheduler / Cron Security Token (Required to invoke /api/v1/scheduler/run)
CRON_SECRET=replace_with_a_secure_random_string

# ------------------------------------------------------------------------------
# 4. LLM CONTENT GENERATION (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=1536
GROQ_TIMEOUT_MS=45000

# Generation rate limiting
GENERATION_MAX_REQUESTS=10
GENERATION_WINDOW_MS=60000
GENERATION_MAX_CONCURRENT=1
GENERATION_MAX_USERS=10000

# ------------------------------------------------------------------------------
# 5. ML RECOMMENDATION SERVICE (CAPSTONE)
# ------------------------------------------------------------------------------
RECOMMENDER_URL=http://localhost:8001/recommend
RECOMMENDER_HEALTH_URL=http://localhost:8001/health
RECOMMENDER_TIMEOUT_MS=15000
# none is allowed for loopback/Render private networking; cloud-run is used for GCP Cloud Run
RECOMMENDER_AUTH_MODE=none
RECOMMENDER_AUDIENCE=

# ------------------------------------------------------------------------------
# 6. PAYMENTS & SUBSCRIPTIONS (Razorpay)
# ------------------------------------------------------------------------------
CHECKOUT_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ------------------------------------------------------------------------------
# 7. SOCIAL PLATFORM OAUTH CREDENTIALS (Meta, Twitter, LinkedIn)
# ------------------------------------------------------------------------------
# Meta Unified Login & Graph API (Instagram + Facebook)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Meta Unified Login Configuration ID (required for Unified OAuth in production)
META_UNIFIED_CONFIG_ID=1128283246795449

# Twitter / X OAuth 2.0 & 1.0a
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE R2 MEDIA STORAGE & BILLING SAFEGUARDS
# ------------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional R2 custom endpoint override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Canonical public HTTPS domain for serving media (e.g. https://media.marketaura4u.com or https://pub-xxx.r2.dev)
R2_PUBLIC_BASE_URL=
R2_REGION=auto
MEDIA_STORAGE_PREFIX=media

# Media Storage Usage & Billing Safeguards (Application-level limits)
MEDIA_UPLOADS_ENABLED=true
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_USER_STORAGE_QUOTA_BYTES=104857600
MEDIA_USER_MONTHLY_UPLOAD_LIMIT=100
