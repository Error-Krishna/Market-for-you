# Backend Environment Variables (Render Web Service)
# Private server-side secrets and configuration

PORT=10000
NODE_ENV=production
PUBLIC_BACKEND_URL=https://<market-aura-api>.onrender.com
FRONTEND_URL=https://<market-aura-project>.vercel.app
CORS_ALLOWED_ORIGINS=https://<market-aura-project>.vercel.app

AUTH_PROXY_MODE=direct
AUTH_WINDOW_MS=900000
AUTH_MAX_IP_ATTEMPTS=30
AUTH_MAX_ACCOUNT_ATTEMPTS=10
AUTH_MAX_CONCURRENT=4
AUTH_MAX_TRACKED_KEYS=10000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/market_aura?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20

JWT_SECREAT_KEY=replace_with_64_character_hex_string
JWT_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_string
CRON_SECRET=replace_with_secure_random_string

GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=1536
GROQ_TIMEOUT_MS=45000

RECOMMENDER_URL=http://market-aura-ml:8080/recommend
RECOMMENDER_HEALTH_URL=http://market-aura-ml:8080/health
RECOMMENDER_AUTH_MODE=none
RECOMMENDER_TIMEOUT_MS=30000

CHECKOUT_ENABLED=true
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://<market-aura-api>.onrender.com/api/v1/auth/social/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://<market-aura-api>.onrender.com/api/v1/auth/social/instagram/callback
META_UNIFIED_CONFIG_ID=1128283246795449

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://<market-aura-api>.onrender.com/api/v1/auth/social/twitter/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://<market-aura-api>.onrender.com/api/v1/auth/social/linkedin/callback

MEDIA_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<media-domain-or-pub-hash>.r2.dev
R2_REGION=auto
MEDIA_STORAGE_PREFIX=media

MEDIA_UPLOADS_ENABLED=true
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_USER_STORAGE_QUOTA_BYTES=104857600
MEDIA_USER_MONTHLY_UPLOAD_LIMIT=100
