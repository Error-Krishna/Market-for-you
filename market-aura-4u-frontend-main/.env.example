# ==============================================================================
# Market Aura 4U — Frontend Web SPA Environment Configuration
# ==============================================================================

# Centralized Backend API Base URL
# In local development: http://localhost:8000/api
# In production on Vercel: https://<market-aura-api>.onrender.com/api
# Accepts: https://<market-aura-api>.onrender.com or with /api or with /api/v1 (normalized automatically)
VITE_API_BASE_URL=http://localhost:8000/api

# Backward-compatible alias for existing environments
VITE_API_URL=http://localhost:8000/api
