# ==============================================================================
# Market Aura 4U — CAPSTONE ML Recommendation Service Environment Variables
# ==============================================================================

# Port to bind the HTTP daemon (default: 8080)
PORT=8080
RECOMMENDER_PORT=8080

# Host to bind (default: 0.0.0.0)
RECOMMENDER_HOST=0.0.0.0
HOST=0.0.0.0

# Prevent online HuggingFace Hub lookups during inference (model weights are pre-baked in Docker image)
HF_HUB_OFFLINE=1

# Optional legacy database connection for training / data exploration scripts
DATABASE_URL=
