# ==============================================================================
# Market Aura 4U — Consolidated Monorepo Environment Configuration
# Copy this file to .env before starting containers or deploying services
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8000
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Rate Limiting & Auth Proxy Security (Direct or Trusted CIDRs)
AUTH_PROXY_MODE=direct
AUTH_WINDOW_MS=900000
AUTH_MAX_IP_ATTEMPTS=30
AUTH_MAX_ACCOUNT_ATTEMPTS=10
AUTH_MAX_CONCURRENT=4
AUTH_MAX_TRACKED_KEYS=10000

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas or Self-Hosted)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/market_aura

# ------------------------------------------------------------------------------
# 3. SECURITY KEYS & SECRETS (Generate with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECREAT_KEY=replace_with_a_secure_random_64_character_hex_string
TOKEN_ENCRYPTION_KEY=replace_with_a_secure_random_64_character_hex_string

# ------------------------------------------------------------------------------
# 4. LLM CONTENT GENERATION (Groq / Gemini)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=1536

# ------------------------------------------------------------------------------
# 5. ML RECOMMENDATION SERVICE (CAPSTONE)
# ------------------------------------------------------------------------------
RECOMMENDER_URL=http://localhost:8080/recommend
RECOMMENDER_HEALTH_URL=http://localhost:8080/health
RECOMMENDER_TIMEOUT_MS=15000
RECOMMENDER_AUTH_MODE=none
RECOMMENDER_AUDIENCE=

# ------------------------------------------------------------------------------
# 6. PAYMENTS & SUBSCRIPTIONS (Razorpay)
# ------------------------------------------------------------------------------
CHECKOUT_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ------------------------------------------------------------------------------
# 7. SOCIAL PLATFORM OAUTH CREDENTIALS (Optional for Core Generation)
# ------------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitter/callback
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/auth/instagram/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback

# ------------------------------------------------------------------------------
# 8. FRONTEND BUNDLE VARIABLES (Baked into Vite build)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
